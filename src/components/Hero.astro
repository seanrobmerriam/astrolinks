---
import { services } from "../data/mock";

const online = services.filter((s) => s.status === "online").length;
---

<section aria-labelledby="hero-heading" class="flex flex-col items-center gap-3 pt-16 text-center sm:pt-24">
  <h1 id="hero-heading" class="text-5xl font-bold tracking-tight text-primary sm:text-7xl">Astrolinks</h1>
  <p class="text-muted">
    <span data-field="online-count" class="font-mono text-foreground">{online}</span>{" of "}<span data-field="total-count" class="font-mono text-foreground"
      >{services.length}</span
    >{" services online"}
  </p>
</section>
