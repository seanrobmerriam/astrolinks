---
import { peekDockerStats } from "../lib/docker";
import { statViews, type StatKey } from "../lib/stats-format";
import StatItem from "./ui/StatItem.astro";

// Never wait on Docker while rendering: show the latest cached stats (or
// placeholders) and let scripts/stats.ts fill in live values.
const result = peekDockerStats();
const views = statViews(result?.ok ? result.stats : null);
const error = result && !result.ok ? result.error : "";

const stats: { stat: StatKey; label: string }[] = [
  { stat: "running", label: "Running" },
  { stat: "cpu", label: "CPU" },
  { stat: "memory", label: "Memory" },
  { stat: "network", label: "Network" },
  { stat: "images", label: "Images" },
  { stat: "uptime", label: "Uptime" },
];
---

<section data-docker-stats aria-label="Docker host stats" class="min-w-0 flex-1">
  <dl data-stats-grid hidden={Boolean(error)} class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-6">
    {stats.map(({ stat, label }) => <StatItem stat={stat} label={label} view={views[stat]} />)}
  </dl>
  <div data-stats-error hidden={!error} role="status" class="flex min-h-11 flex-col justify-center gap-0.5 text-sm">
    <p class="font-medium text-warning">Docker stats unavailable</p>
    <p data-field="stats-error" class="text-muted">{error}</p>
  </div>
</section>

<script>
  import "../scripts/stats";
</script>
