---
import { services, type Service } from "../data/mock";
import Section from "./layout/Section.astro";
import Icon from "./ui/Icon.astro";
import ServiceCard from "./ui/ServiceCard.astro";

const placeholder: Service = { id: "", name: "", url: "http://localhost", description: "", status: "online" };
---

<Section id="services" title="Services" meta={`${services.length} total`}>
  <ul data-service-list class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,17rem),1fr))] gap-3">
    {services.map((service) => <ServiceCard service={service} />)}
    <li data-add-tile class="hidden editing:grid">
      <button
        type="button"
        data-action="add-service"
        class="flex min-h-24 items-center justify-center gap-2 rounded-lg border border-dashed border-border p-4 text-sm font-medium text-muted transition-colors hover:border-primary hover:text-primary"
      >
        <Icon name="plus" />
        Add service
      </button>
    </li>
  </ul>
  <template data-template="service"><ServiceCard service={placeholder} /></template>
</Section>
