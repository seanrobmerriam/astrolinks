---
import type { Service } from "../../lib/schema";
import Icon from "./Icon.astro";
import IconButton from "./IconButton.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  service: Service;
}

const { service } = Astro.props;

function hostOf(url: string) {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
}
---

<!-- Rendered by the server and cloned from a <template> by the editor script; keep the data-* hooks in sync. -->
<li data-id={service.id} class="relative grid">
  <a
    data-service-link
    href={service.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-start gap-4 rounded-lg border border-border bg-surface p-4 transition hover:border-primary hover:bg-surface-raised motion-safe:hover:-translate-y-0.5 editing:border-dashed"
  >
    <span
      data-field="initial"
      class="grid size-11 shrink-0 place-items-center rounded-md bg-surface-raised font-mono text-lg font-semibold text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground"
      aria-hidden="true"
    >
      {service.name.charAt(0).toUpperCase()}
    </span>
    <span class="flex min-w-0 flex-1 flex-col gap-1">
      <span class="flex items-center justify-between gap-2">
        <span data-field="name" class="truncate font-semibold text-foreground">{service.name}</span>
        <StatusBadge status={service.status} />
      </span>
      <span data-field="description" class="truncate text-sm text-muted">{service.description}</span>
      <span data-field="host" class="truncate font-mono text-xs text-muted/80">{hostOf(service.url)}</span>
    </span>
  </a>
  <div class="absolute top-3 right-3 hidden gap-1 editing:flex">
    <IconButton data-action="edit-service" label={`Edit ${service.name}`}>
      <Icon name="pencil" />
    </IconButton>
    <IconButton data-action="remove-service" variant="danger" label={`Remove ${service.name}`}>
      <Icon name="trash" />
    </IconButton>
  </div>
</li>
