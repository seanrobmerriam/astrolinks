---
import type { ServiceStatus } from "../../data/mock";
import { statusBadgeBase, statusDotBase, statusStyles } from "../../lib/status";

interface Props {
  status: ServiceStatus;
}

const { dot, text, label } = statusStyles[Astro.props.status];
---

<span data-status class:list={[statusBadgeBase, text]}>
  <span data-status-dot class:list={[statusDotBase, dot]} aria-hidden="true"></span>
  <span data-field="status-label">{label}</span>
</span>
