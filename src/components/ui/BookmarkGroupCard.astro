---
import type { BookmarkGroup } from "../../data/mock";

interface Props {
  group: BookmarkGroup;
}

const { group } = Astro.props;
---

<article class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4">
  <h3 class="font-semibold text-foreground">{group.title}</h3>
  <ul class="flex flex-col">
    {
      group.links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-10 items-center gap-2 rounded-sm text-sm text-muted transition-colors hover:text-primary"
          >
            <span class="text-primary/60 transition-colors group-hover:text-primary" aria-hidden="true">
              ›
            </span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</article>
