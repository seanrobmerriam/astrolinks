---
import { statusOptions } from "../lib/status";
import Dialog from "./ui/Dialog.astro";
import Field from "./ui/Field.astro";
import Icon from "./ui/Icon.astro";

// Initial data for the editor script. "<" is escaped so a value can't close the <script>.
const initialData = JSON.stringify(Astro.locals.dashboard).replace(/</g, "\\u003c");
---

<script type="application/json" id="dashboard-data" set:html={initialData} />

<Dialog id="service-dialog" title="Add service" submitLabel="Save">
  <input type="hidden" name="id" />
  <Field id="service-name" name="name" label="Name" required placeholder="Jellyfin" />
  <Field id="service-url" name="url" label="URL" type="url" required placeholder="http://jellyfin.home.lan" />
  <Field id="service-description" name="description" label="Description" placeholder="Movies, shows and music" />
  <Field id="service-status" name="status" label="Status" options={statusOptions} required />
</Dialog>

<Dialog id="bookmark-dialog" title="Add bookmark" submitLabel="Save">
  <input type="hidden" name="id" />
  <input type="hidden" name="originalGroupId" />
  <Field id="bookmark-label" name="label" label="Label" required placeholder="GitHub" />
  <Field id="bookmark-url" name="url" label="URL" type="url" required placeholder="https://github.com" />
  <Field id="bookmark-group" name="groupId" label="Group" options={[]} required />
</Dialog>

<Dialog id="confirm-dialog" title="Remove item?" submitLabel="Remove" submitVariant="danger">
  <p data-field="confirm-message" class="text-sm text-muted"></p>
</Dialog>

<p data-field="status-message" role="status" class="sr-only"></p>

<!-- Shown when a save fails; role="alert" announces the message. -->
<div
  data-save-error
  role="alert"
  hidden
  class="fixed inset-x-4 bottom-4 z-10 mx-auto flex max-w-md items-start gap-3 rounded-lg border border-danger bg-surface p-4 text-sm text-foreground shadow-2xl"
>
  <p data-field="save-error" class="min-w-0 flex-1 whitespace-pre-line"></p>
  <button
    type="button"
    data-action="dismiss-error"
    aria-label="Dismiss"
    class="grid size-8 shrink-0 place-items-center rounded-md text-muted hover:text-foreground"
  >
    <Icon name="plus" class="size-4 rotate-45" />
  </button>
</div>

<script>
  import "../scripts/editor";
</script>
